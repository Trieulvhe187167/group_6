<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <!-- Run Action -->
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dfile.encoding=UTF-8</spring-boot.run.jvmArguments>
            <spring-boot.run.mainClass>hms.HotelManagementSystemApplication</spring-boot.run.mainClass>
            <Env.SPRING_OUTPUT_ANSI_ENABLED>always</Env.SPRING_OUTPUT_ANSI_ENABLED>
            <skipTests>true</skipTests>
        </properties>
    </action>
    
    <!-- Debug Action -->
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address} -Dfile.encoding=UTF-8</spring-boot.run.jvmArguments>
            <spring-boot.run.mainClass>hms.HotelManagementSystemApplication</spring-boot.run.mainClass>
            <Env.SPRING_OUTPUT_ANSI_ENABLED>always</Env.SPRING_OUTPUT_ANSI_ENABLED>
            <jpda.listen>true</jpda.listen>
            <skipTests>true</skipTests>
        </properties>
    </action>
    
    <!-- Build Action -->
    <action>
        <actionName>build</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
        <properties>
            <skipTests>true</skipTests>
        </properties>
    </action>
    
    <!-- Clean and Build -->
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
        <properties>
            <skipTests>true</skipTests>
        </properties>
    </action>
</actions>