<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <skipTests>true</skipTests>
            <netbeans.deploy.open.in.browser>true</netbeans.deploy.open.in.browser>
            <netbeans.deploy.clientUrlPart>/</netbeans.deploy.clientUrlPart>
        </properties>
    </action>
    
    <action>
        <actionName>run.single.main</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:1.5.0:exec</goal>
        </goals>
        <properties>
            <exec.args>-classpath %classpath hms.HotelManagementSystemApplication</exec.args>
            <exec.executable>java</exec.executable>
            <netbeans.deploy.open.in.browser>true</netbeans.deploy.open.in.browser>
        </properties>
    </action>
    
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <skipTests>true</skipTests>
            <jpda.listen>true</jpda.listen>
            <spring-boot.run.jvmArguments>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
        </properties>
    </action>
</actions>